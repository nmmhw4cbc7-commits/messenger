# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
# The exact origin users open, https in production.
PUBLIC_ORIGIN=https://chat.example.com
PORT=8080
HOST=0.0.0.0
# Set to true when running behind a reverse proxy (Caddy, nginx, a load balancer),
# so rate limits see the real client IP.
TRUST_PROXY=true
# Where the SQLite database lives. Back it up and keep it private.
DATA_DIR=./data

# SMS verification through Twilio Verify (https://www.twilio.com/docs/verify).
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Region used when someone types a number without a country code.
DEFAULT_REGION=DE

# Optional
# SESSION_DAYS=60
# MESSAGE_RETENTION_DAYS=30
# MAX_GROUP_SIZE=100
# VAPID_SUBJECT=mailto:admin@example.com
